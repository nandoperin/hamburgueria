# ============================================================
# Bot WhatsApp — Hamburgueria
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git
# ============================================================

# --- Servidor ---
PORT=3000

# Vale mais do que parece: fora de `development`/`test`, a falta de um segredo
# de autenticacao FECHA a porta em vez de liberar (503 no CloudPRNT). Esquecer
# esta linha e seguro; erra-la para `development` em producao nao e.
# A pergunta e invertida de proposito — "isto foi DECLARADO desenvolvimento?" —
# para que a variavel ausente caia do lado fechado. Ver docs/SEGURANCA.md.
NODE_ENV=development               # development | test | production

# URL publica do servidor. A impressora precisa alcanca-la.
# Em desenvolvimento: rode `ngrok http 3000` e cole a URL gerada aqui.
BASE_URL=https://seu-dominio.com

# --- Supabase ---
# Supabase -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxx

# ============================================================
# IA — a conversa
# ============================================================

# on | off. Com `off` o bot cai na maquina de estados (cardapio numerado,
# carrinho, checkout): feio, e funcionando. E o interruptor para provedor fora
# do ar, cota estourada, ou comportamento estranho no meio do servico.
AI_ENABLED=on

# Provedores IMPLEMENTADOS hoje: mistral, claude.
# `openai` esta previsto em `docs/` mas `src/ai/openai.js` ainda nao existe —
# por isso nao esta aqui. Provedor que nao existe derruba o boot com a
# mensagem na tela, em vez de deixar o bot atendendo pelo cardapio numerado
# sem ninguem saber.
#
# Em producao (Railway) e sempre mistral — e quem atende de verdade. `claude`
# existe para COMPARAR, com `scripts/prova-conversa.js --provedor=claude`,
# sem mexer em mais nada do bot.
AI_PROVIDER=mistral

# Chave do provedor escolhido. So a do provedor ativo e exigida no boot.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Modelo. mistral-small e o padrao: barato e entende portugues de verdade.
# Rode `npm run prova-conversa` para medir se ele da conta das 8 ferramentas.
#
# Para comparar com a Anthropic, o mais barato hoje e claude-haiku-4-5
# ($1 entrada / $5 saida por milhao de tokens — confira contra a pagina de
# billing, preco muda):
#   node scripts/prova-conversa.js --provedor=claude --modelo=claude-haiku-4-5
AI_MODEL=mistral-small-latest

# Leitura auxiliar do print pela Mistral. Nunca libera pagamentos.
# Uma tentativa por comprovante aceito, timeout 15s, respeita os tetos abaixo.
# Ausente = on; off mantem envio do print ao dono sem leitura por IA.
AI_PROOF_READING=on

# --- Tetos de custo ---
# Cada mensagem do cliente e uma chamada paga. Estes tetos existem para que um
# numero em laco nao vire fatura — o teto de vazao (20 msg/min por telefone)
# ja limita a frequencia; estes limitam o total.
#
# Estourou qualquer um, o bot cai no cardapio numerado: ninguem fica sem ser
# atendido. O teto do dia avisa o ADMIN_PHONE uma vez, e rearma a meia-noite.
# Quem faz a conta e `src/ai/custo.js`; o registro duravel e a tabela `ai_usage`.
#
# Deixar a variavel em branco NAO desliga o teto — cai no padrao abaixo. Para
# desligar de verdade, ponha `0` (decisao que alguem precisa digitar).
AI_MAX_TURNOS=40                   # turnos de conversa por sessao
AI_MAX_TOKENS_CONVERSA=120000      # tokens acumulados por sessao
AI_MAX_USD_DIA=10                  # gasto diario; estourou, cai no fluxo numerado

# Preco do seu modelo, em dolar por 1 MILHAO de tokens. Opcional: `custo.js` tem
# uma tabela embutida por modelo. Preencha os dois quando quiser o numero exato
# da sua pagina de billing — preco de modelo muda, e a tabela envelhece.
# Modelo que a tabela nao conhece e contado pelo mais caro, de proposito: teto
# que nunca dispara e o defeito que estes tetos existem para consertar.
AI_PRECO_IN=
AI_PRECO_OUT=

# ============================================================
# WhatsApp
# ============================================================

# baileys = WhatsApp Web via QR code (precisa de processo 24h)
# meta    = Meta Cloud API oficial (por webhook)
WHATSAPP_PROVIDER=baileys

# --- Pareamento por codigo (em vez do QR) ---
# Numero do PROPRIO bot, so digitos, com codigo de pais. Ex: 16175551234
#
# Com ele preenchido, o bot pede um CODIGO DE 8 CARACTERES em vez de desenhar o
# QR. No celular: Aparelhos conectados -> Conectar aparelho -> "Conectar com
# numero de telefone".
#
# Existe por um motivo pratico de hospedagem: o QR sai no log como 33 linhas de
# arte ASCII, e o visualizador do Railway poe cada linha numa raia com coluna de
# horario, quebrando o desenho. Nao ha celular que leia aquilo. O codigo cabe em
# UMA linha.
#
# NAO e segredo — e o numero que o cliente disca. Nao confunda com ADMIN_PHONE,
# que autoriza comandos de dono.
# Vazio = usa o QR de sempre.
PAIR_PHONE=

# on | off — botoes e listas no Baileys.
#
# ATENCAO: o Baileys pode ENVIAR com sucesso uma mensagem que o celular nao
# renderiza. Nao ha excecao para o codigo detectar, entao a degradacao
# automatica NAO cobre esse caso. Teste olhando a tela de um celular de
# verdade, e use `off` se nao aparecer. Ver docs/WHATSAPP.md.
BAILEYS_RICH=on

# --- Meta Cloud API (so quando WHATSAPP_PROVIDER=meta) ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v22.0

# --- WhatsApp Admin ---
# Numero do dono, so digitos. (555) 123-4567 vira 15551234567
# Quem pode usar os comandos administrativos (!liberar, !recusar, relatorios).
# Aceita mais de um, separados por virgula. Minimo 10 digitos cada.
ADMIN_PHONE=15551234567

# --- Telefone publico de atendimento ---
# Vai nas mensagens ao cliente e na comanda ("Duvidas? Ligue ...").
# Separado do ADMIN_PHONE de proposito: aquele autoriza comandos.
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ============================================================
# Pagamento (Zelle)
# ============================================================
# Os dados do Zelle (nome, email do destinatario) ficam em
# config/pagamento.json, nao aqui — sao conteudo de negocio, como o cardapio.

# Teto do comprovante em MB. Sem teto, o cliente escolhe quanta banda e
# memoria o servidor gasta.
PROOF_MAX_MB=5

# ============================================================
# Painel do dono (web)
# ============================================================
# Segredo que assina os links do !painel. MINIMO 16 caracteres.
#
# Sem ele o painel responde 503 e o !painel recusa — a mesma inversao do
# CLOUDPRNT_TOKEN: variavel ausente cai do lado FECHADO, nunca do aberto.
#
# Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Trocar este valor invalida todos os links em circulacao na hora. E o que
# fazer se um link vazar.
PAINEL_SECRET=

# ============================================================
# Impressora Star TSP143IV-UEWB (CloudPRNT)
# ============================================================
# Configure https://SEU_BASE_URL/cloudprnt?authToken=SEU_TOKEN
# na pagina de setup da impressora.
#
# Sem este token, fora de desenvolvimento, o /cloudprnt responde 503 — a
# comanda leva nome, endereco e telefone do cliente, e a BASE_URL e publica
# por necessidade.
CLOUDPRNT_TOKEN=um-token-secreto-qualquer

# Copias por pedido (1 = cozinha, 2 = cozinha + entregador)
PRINTER_COPIES=1

# markup (fonte ampliada) ou plain (texto puro)
# Troque para plain se a impressora imprimir as tags como texto literal.
PRINTER_FORMAT=plain

# Minutos entre a liberacao e o aviso de comanda nao impressa
PRINT_ALERT_MINUTES=2

# --- Identidade ---
# Aparece no cabecalho da comanda e nas mensagens ao cliente.
BUSINESS_NAME=Minha Hamburgueria

# --- Sessao ---
# Minutos de inatividade ate a conversa reiniciar.
# Generoso de proposito: expirar cedo perde uma venda, viver demais nao custa
# quase nada — a sessao e um objeto na memoria e o preco e congelado no
# carrinho quando o item entra.
SESSION_TIMEOUT_MINUTES=20

# --- Log ---
# debug | info | warn | error | silent (padrao: info)
LOG_LEVEL=info

# json | pretty. Sem isto: pretty no terminal, json no servidor.
# LOG_FORMAT=json

# off tira o texto das mensagens do log — o resto continua.
# LOG_TEXTO=off

# ------------------------------------------------------------
# Cardapio, ingredientes, cidades, horario, FAQ e dados do Zelle
# ficam em config/*.json
# ------------------------------------------------------------
